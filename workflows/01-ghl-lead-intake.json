    {
      "parameters": {
        "jsCode": "// Normalize the raw form payload and score the lead.\n// Expected body: { name, email, phone?, company?, budget?, message?, source? }\nreturn $input.all().map(item => {\n  const b = item.json.body ?? {};\n  const email = String(b.email ?? '').trim().toLowerCase();\n  const phone = String(b.phone ?? '').replace(/[^\\d+]/g, '');\n  const [firstName = '', ...rest] = String(b.name ?? b.firstName ?? '').trim().split(/\\s+/);\n  const lastName = b.lastName ?? rest.join(' ');\n  const company = String(b.company ?? '').trim();\n  const message = String(b.message ?? '');\n  const budget = Number(b.budget) || 0;\n\n  const errors = [];\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('a valid email is required');\n  if (!firstName) errors.push('name is required');\n\n  const score =\n    (budget >= 5000 ? 50 : budget >= 1000 ? 40 : 0) +\n    (phone ? 20 : 0) +\n    (company ? 15 : 0) +\n    (message.length > 50 ? 15 : 0);\n  const temperature = score >= 60 ? 'hot' : score >= 30 ? 'warm' : 'cold';\n\n  return {\n    json: {\n      valid: errors.length === 0,\n      errors,\n      firstName,\n      lastName,\n      email,\n      phone,\n      company,\n      budget,\n      source: b.source ?? 'website',\n      score,\n      temperature,\n    },\n  };\n});"
      },
